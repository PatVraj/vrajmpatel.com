---
interface Step { title: string; purpose: string; technical: string; }
interface Props { steps: readonly Step[]; label?: string; heading?: string; description?: string; }
const { steps, label = "Architecture", heading = "How the parts work together", description = "Follow the responsibilities through the system. Expand a step for the decision behind it." } = Astro.props;
---
<figure id="architecture" class="page-section" aria-labelledby="system-path-heading">
  <figcaption data-reveal><p class="eyebrow">{label}</p><h2 id="system-path-heading" class="section-title">{heading}</h2><p class="muted-copy">{description}</p></figcaption>
  <ol class="mt-6 border-t border-slate-200 dark:border-slate-800">
    {steps.map((step, i) => <li class="system-step" data-reveal>
      <span class="eyebrow" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
      <h3>{step.title}</h3>
      <div class="step-content"><p>{step.purpose}</p><details><summary>{step.title}: design details</summary><p>{step.technical}</p></details></div>
    </li>)}
  </ol>
</figure>
