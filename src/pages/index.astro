---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import ExperienceItem from "../components/ExperienceItem.astro";
import ProofGrid from "../components/ProofGrid.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { profile } from "../data/profile";
import ContactBlock from "../components/ContactBlock.astro";
import { proofPoints } from "../data/recruiter";
import {
  isCaseStudy,
  isPublicExperience,
  isPublicProject,
  sortProjects,
} from "../lib/projects";
import BaseLayout from "../layouts/BaseLayout.astro";

const featured = (await getCollection("projects", ({ data }) => data.featured))
  .filter(isPublicProject)
  .filter(isCaseStudy)
  .sort(sortProjects)
  .slice(0, 3);

const recentExperience = (await getCollection("experience"))
  .filter(isPublicExperience)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---
<BaseLayout title="Vraj Patel — Systems Integration Engineer" description="Backend services, data pipelines, and applied ML systems built by Vraj Patel at CU Boulder." schemaType="Person">
  <section class="home-intro" aria-labelledby="intro-heading">
    <div>
      <p class="eyebrow">{profile.role} · {profile.location}</p>
      <h1 id="intro-heading" class="home-name" data-intro>{profile.name}</h1>
    </div>
    <Image src="/profile.jpg" alt="Portrait of Vraj Patel" width={176} height={208} class="home-portrait" fetchpriority="high" loading="eager" />
    <div class="home-intro-copy">
      <p class="home-statement" data-intro>I build backend services, data pipelines, and tools for support operations.</p>
      <p class="muted-copy">At CU Boulder’s Institute of Behavioral Science. My work connects Python, SQL, applied ML, and the people who use the results.</p>
      <nav class="action-row" aria-label="Explore my work">
        <a href="#selected-work" class="button-primary">Explore the work</a>
        <a href="/brief" class="text-link" data-ph-event="recruiter_brief_opened" data-ph-placement="hero">Recruiter brief</a>
        <a href="#contact" class="text-link">Contact</a>
      </nav>
    </div>
  </section>

  <section id="selected-work" class="page-section" aria-labelledby="work-heading">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">Selected work</p><h2 id="work-heading" class="section-title">Three systems. Different problems.</h2></div>
      <a href="/projects" class="text-link">All case studies</a>
    </div>
    <div class="mt-6">{featured.map(entry => <ProjectCard entry={entry} headingLevel="h3" variant="compact" />)}</div>
  </section>

  <section class="page-section" aria-labelledby="proof-heading">
    <div data-reveal><p class="eyebrow">Evidence at a glance</p><h2 id="proof-heading" class="section-title">Results with context.</h2></div>
    <ProofGrid items={proofPoints} class="mt-6" />
  </section>

  <section class="page-section" aria-labelledby="experience-heading">
    <div class="section-heading" data-reveal>
      <div><p class="eyebrow">Career</p><h2 id="experience-heading" class="section-title">Engineering and research.</h2></div>
      <a href="/experience" class="text-link">Full experience</a>
    </div>
    <div class="mt-6">{recentExperience.map(entry => <ExperienceItem entry={entry} variant="compact" />)}</div>
  </section>
  <ContactBlock />
</BaseLayout>
